# Copy to .env.local for local work. Set the same keys in Vercel for each environment.

# Public URL, https, no trailing slash (used for canonical URLs, sitemap, share cards).
NEXT_PUBLIC_SITE_URL=

# "true" only at launch: until then robots.txt blocks everything and pages send noindex.
NEXT_PUBLIC_SITE_LIVE=false

# Waitlist mode: contact (default, no data stored) | live (needs D-004 + D-010) | paused
NEXT_PUBLIC_WAITLIST_MODE=contact

# Public contact details shown on the site (brief Q4). Leave empty until decided.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=

# Development only: accept test sign-ups and log non-personal fields. Ignored in production.
# WAITLIST_STORE=dev-log
